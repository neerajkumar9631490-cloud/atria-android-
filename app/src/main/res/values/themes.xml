<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Atria" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/atria_bg</item>
        <item name="android:statusBarColor">@color/atria_bg</item>
        <item name="android:navigationBarColor">@color/atria_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Production launch splash: brand background + accent mark, then Theme.Atria -->
    <style name="Theme.Atria.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/atria_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.Atria</item>
    </style>
</resources>
